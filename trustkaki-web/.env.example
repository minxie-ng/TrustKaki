# TrustKaki environment template.
# Copy this file to .env.local for local development, or configure these values
# in Vercel Project Settings. Do not commit real secret values.

# Required for Judge View: OpenAI-compatible LLM provider.
# WorkBuddy can later replace or extend this provider through src/lib/agents/provider.ts.
TRUSTKAKI_LLM_API_KEY=
TRUSTKAKI_LLM_BASE_URL=https://api.openai.com/v1
TRUSTKAKI_LLM_MODEL=gpt-4o-mini
TRUSTKAKI_LLM_TIMEOUT_MS=30000

# Optional Jev social-decision model through OpenRouter (server only).
# Opt in for activity-related chat; failures produce no activity suggestion.
TRUSTKAKI_JEV_ENABLED=false
OPENROUTER_API_KEY=

# Optional routing observation only; existing routing, replies and policy retain authority.
# Adds one bounded OpenRouter request per chat turn. Enable only for an approved evaluation.
# Separate from social decisions; sends the current message and bounded context.
TRUSTKAKI_JEV_ROUTING_SHADOW_ENABLED=false

# Required for Judge View: Supabase persistence.
# NEXT_PUBLIC_* values are browser-visible by design. Do not put secrets there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required only for live WhatsApp.
# These are server-side secrets/configuration. Never expose them in client code
# or NEXT_PUBLIC_* variables. Meta temporary access tokens are development-only;
# production should use an appropriate durable Meta credential.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
META_APP_SECRET=
WHATSAPP_INTERNAL_PROCESSOR_SECRET=

# Demo phone mapping for live WhatsApp senior lookup.
TRUSTKAKI_DEMO_SENIOR_PHONE=

# Required only for live Telegram demo continuity.
# These values are server-side secrets. TELEGRAM_WEBHOOK_SECRET is supplied to
# Telegram during setWebhook and must contain only A-Z, a-z, 0-9, underscore,
# and hyphen characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INTERNAL_PROCESSOR_SECRET=

# Required for Vercel Cron to process durable proactive check-in jobs.
# Generate a high-entropy server-only value. Vercel sends it as a Bearer token.
CRON_SECRET=

# Development-only flags.
ENABLE_WHATSAPP_DEV_SIMULATOR=false
ENABLE_TELEGRAM_DEV_SIMULATOR=false
TRUSTKAKI_RUN_DB_INTEGRATION=0
TRUSTKAKI_RUN_LIVE_SUPABASE=0

# Optional: allows the slow 4-message Full Agent Replay in production.
# Keep unset for judge/demo deployment; Quick Demo is the primary production path.
ENABLE_FULL_AGENT_REPLAY=false

# Optional isolated fictional personal-memory pilot. No production integration.
# Keep these local; never use a production index or senior data for this pilot.
# Index dimensions must match the selected embedding model; use cosine metric.
# The script records a declared budget; configure spending limits at providers.
TRUSTKAKI_MEMORY_PINECONE_PILOT_HOST=
TRUSTKAKI_MEMORY_PINECONE_API_KEY=
# Pinecone native option: https://api.pinecone.io/embed with llama-text-embed-v2.
# Other providers use their OpenAI-compatible /embeddings endpoint.
TRUSTKAKI_MEMORY_EMBEDDING_ENDPOINT=
# Leave blank for the exact native Pinecone endpoint; it uses PINECONE_API_KEY.
TRUSTKAKI_MEMORY_EMBEDDING_API_KEY=
TRUSTKAKI_MEMORY_EMBEDDING_MODEL=
# Calibrate separately from the final evaluation questions; no assumed threshold.
TRUSTKAKI_MEMORY_PILOT_MIN_SCORE=
TRUSTKAKI_MEMORY_PILOT_REGION=
TRUSTKAKI_MEMORY_PILOT_PLAN=
TRUSTKAKI_MEMORY_PILOT_BUDGET_USD=

# Neon Postgres personal-memory foundation. Populated by neon deploy/env pull.
# DATABASE_URL is pooled application traffic; UNPOOLED is for migrations only.
# These are server-only secrets. Existing production agent memory is not cut over.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Application personal-memory backend. Keep supabase until migration/release gates pass.
# Never expose these settings through NEXT_PUBLIC_*.
TRUSTKAKI_PERSONAL_MEMORY_BACKEND=supabase
# Required in neon mode; calibrate for the configured embedding model.
TRUSTKAKI_MEMORY_MIN_SCORE=
