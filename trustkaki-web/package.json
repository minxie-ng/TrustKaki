{
  "name": "trustkaki-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./node_modules/.bin/next dev",
    "build": "./node_modules/.bin/next build --webpack",
    "start": "./node_modules/.bin/next start",
    "benchmark:agents": "./node_modules/.bin/tsx scripts/agent-benchmark.ts --mode deterministic",
    "benchmark:agents:live": "./node_modules/.bin/tsx scripts/agent-benchmark.ts --mode live --confirm-live",
    "benchmark:memory": "node --conditions=react-server --import tsx scripts/memory-retrieval-evaluation.ts",
    "release:smoke": "node scripts/release-smoke.mjs",
    "lint": "./node_modules/.bin/eslint",
    "test": "./node_modules/.bin/vitest run",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "validate": "npm run test && npm run typecheck && npm run lint && npm run build",
    "memory:neon:migrate": "node --env-file=.env.local --import tsx scripts/neon-memory-migrate.ts",
    "memory:neon:smoke": "node --env-file=.env.local --conditions=react-server --import tsx scripts/neon-memory-smoke.ts",
    "memory:neon:evaluate": "node --env-file=.env.local --conditions=react-server --import tsx scripts/neon-memory-evaluation.ts",
    "memory:neon:runtime": "node --import tsx scripts/neon-memory-runtime.ts",
    "memory:neon:app-smoke": "node --env-file=.env.local --conditions=react-server --import tsx scripts/neon-memory-app-smoke.ts",
    "memory:neon:backfill": "node --env-file=.env.local --import tsx scripts/neon-memory-backfill.ts"
  },
  "dependencies": {
    "@neon/config": "1.9.1",
    "@neon/env": "1.6.2",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "@vercel/functions": "3.10.1",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
